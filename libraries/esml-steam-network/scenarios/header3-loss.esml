<?xml version="1.0"?>
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="SteamHeader3Loss">
  <use library="cn.ai4energy.esml:esml-steam-network:0.1.0"/>
  <units name="steam-units">
    <unitsBase>
      <unit name="K" base="Theta" scale="1" offset="0"/>
      <unit name="Pa" base="Pa" scale="1" offset="0"/>
      <unit name="J" base="J" scale="1" offset="0"/>
      <unit name="kg" base="M" scale="1" offset="0"/>
      <unit name="m" base="L" scale="1" offset="0"/>
      <unit name="s" base="T" scale="1" offset="0"/>
    </unitsBase>
  </units>

  <systems><system name="S"><instances><instance name="g" type="SteamHeader3Loss"/></instances><sets><scope instance="g"><set path="p_h" value="4000000.0"/><set path="m1" value="2.0"/><set path="m2" value="3.0"/><set path="m3" value="1.0"/><set path="D1" value="0.15"/><set path="D2" value="0.12"/><set path="D3" value="0.08"/></scope></sets></system></systems>
  <computeTasks name="steam-tasks" target="S">
    <task name="steady" kind="simulate">
      <tspan from="0" to="1"/>
      <solver name="Tsit5" steps="2"/>
    </task>
  </computeTasks>
</esml>
