<?xml version="1.0" encoding="UTF-8"?>
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="Storage">
  <use library="cn.ai4energy.esml:esml-units:0.1.0"/>
  <use library="cn.ai4energy.esml:esml-connectors:0.1.0"/>
  <use library="cn.ai4energy.esml:esml-electrical:0.1.0"/>
  <use library="cn.ai4energy.esml:esml-thermal:0.1.0"/>
  <modelTypes>
    <modelType name="Battery" discipline="storage">
      <ports><port name="power" portType="ElectricalPin"/></ports>
      <parameters>
        <parameter name="E_cap" type="real" default="10.0"/>
        <parameter name="eta_ch" type="real" default="0.95"/>
        <parameter name="eta_dis" type="real" default="0.95"/>
      </parameters>
      <variables><variable name="SOC" type="real" role="state" initial="0.2"/></variables>
      <equations>
        <equation>Der(SOC) = eta_ch * power.i * power.v / E_cap</equation>
      </equations>
    </modelType>
    <modelType name="ThermalStorage" discipline="storage">
      <ports><port name="heat" portType="ThermalPort"/></ports>
      <parameters>
        <parameter name="C" type="real" default="3600000.0"/>
        <parameter name="T_amb" type="real" default="293.15"/>
        <parameter name="UA" type="real" default="5.0"/>
      </parameters>
      <variables><variable name="T" type="real" role="state" initial="300.0"/></variables>
      <equations>
        <equation>C * Der(T) = heat.Q - UA * (T - T_amb)</equation>
      </equations>
    </modelType>
    <modelType name="HydrogenStore" discipline="storage">
      <ports>
        <port name="flow" portType="SignalPort"/>
      </ports>
      <parameters>
        <parameter name="capacity" type="real" default="100.0"/>
        <parameter name="LHV" type="real" default="33.3"/>
      </parameters>
      <variables><variable name="m" type="real" role="state" initial="0.0"/></variables>
      <equations><equation>Der(m) = flow.y</equation></equations>
    </modelType>
  </modelTypes>
</esml>
