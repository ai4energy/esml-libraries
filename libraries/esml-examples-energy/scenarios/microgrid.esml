<?xml version="1.0" encoding="UTF-8"?>
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="Microgrid">
  <use library="cn.ai4energy.esml:esml-electrical:0.1.0"/>
  <use library="cn.ai4energy.esml:esml-renewable:0.1.0"/>
  <modelTypes>
    <modelType name="MicrogridBus" discipline="systems">
      <ports>
        <port name="pv" portType="ElectricalPin"/>
        <port name="wind" portType="ElectricalPin"/>
        <port name="batt" portType="ElectricalPin"/>
        <port name="load" portType="ElectricalPin"/>
        <port name="grid" portType="ElectricalPin"/>
      </ports>
      <variables>
        <variable name="pv.v" type="real" role="algebraic"/>
        <variable name="wind.v" type="real" role="algebraic"/>
        <variable name="batt.v" type="real" role="algebraic"/>
        <variable name="load.v" type="real" role="algebraic"/>
        <variable name="grid.v" type="real" role="algebraic"/>
        <variable name="pv.i" type="real" role="algebraic"/>
        <variable name="wind.i" type="real" role="algebraic"/>
        <variable name="batt.i" type="real" role="algebraic"/>
        <variable name="load.i" type="real" role="algebraic"/>
        <variable name="grid.i" type="real" role="algebraic"/>
      </variables>
      <equations>
        <equation>pv.v = wind.v</equation>
        <equation>pv.v = batt.v</equation>
        <equation>pv.v = load.v</equation>
        <equation>pv.v = grid.v</equation>
        <equation>pv.i + wind.i + batt.i + load.i + grid.i = 0</equation>
      </equations>
    </modelType>
    <modelType name="FixedLoad" discipline="systems">
      <ports><port name="power" portType="ElectricalPin"/></ports>
      <parameters><parameter name="P" type="real" default="20000.0"/></parameters>
      <variables>
        <variable name="power.v" type="real" role="algebraic"/>
        <variable name="power.i" type="real" role="algebraic"/>
      </variables>
      <equations><equation>power.i * power.v = P</equation></equations>
    </modelType>
    <modelType name="FixedStorage" discipline="systems">
      <ports><port name="power" portType="ElectricalPin"/></ports>
      <parameters><parameter name="P" type="real" default="-5000.0"/></parameters>
      <variables>
        <variable name="power.v" type="real" role="algebraic"/>
        <variable name="power.i" type="real" role="algebraic"/>
      </variables>
      <equations><equation>power.i * power.v = P</equation></equations>
    </modelType>
  </modelTypes>
  <systems>
    <system name="Bus">
      <instances>
        <instance name="bus" type="MicrogridBus"/>
        <instance name="pv" type="PVArray"/>
        <instance name="wind" type="WindTurbine"/>
        <instance name="batt" type="FixedStorage"/>
        <instance name="load" type="FixedLoad"/>
        <instance name="grid" type="GridSource"/>
      </instances>
      <connections>
        <connection from="pv.power" to="bus.pv"/>
        <connection from="wind.power" to="bus.wind"/>
        <connection from="batt.power" to="bus.batt"/>
        <connection from="load.power" to="bus.load"/>
        <connection from="grid.pin" to="bus.grid"/>
      </connections>
      <sets>
        <scope instance="pv"><set path="A" value="30.0"/><set path="G" value="1000.0"/></scope>
        <scope instance="wind"><set path="D" value="10.0"/><set path="v" value="10.0"/></scope>
        <scope instance="batt"><set path="P" value="-5000.0"/></scope>
        <scope instance="load"><set path="P" value="20000.0"/></scope>
        <scope instance="grid"><set path="U" value="400.0"/></scope>
      </sets>
    </system>
  </systems>
</esml>
