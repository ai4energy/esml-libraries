<?xml version="1.0" encoding="UTF-8"?>
<!-- 水网 DTIL 组件库（0.1.0，experimental）。

     来源：esml-engine 的 library/domains/hydraulic/water_network.comp.esml
     的 DTIL 子集，按 esml-libraries 坐标重新发布；方程与端口语义逐字保留，
     只去掉应用层不需要的 Tank/TankDyn/FCV/PSV/TCV/泵曲线族。

     单位：与引擎水网库一致，H/Q 声明为 unit=1（无量纲）。这是**有意**的：
     引擎水网库的水头/流量单位层还没完成，库内先按“数值即 SI”使用；
     应用层用 EPANET 标高另算压力（m）。不要把 unit=1 当成物理单位。

     端口：
       Hydraulic     H potential / Q flow
       SpeedInput    v input（泵转速指令）
       SpeedOutput   v output（转速指令源）
-->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="WaterNetwork">

  <variableTypes name="water-types">
    <type name="real" unit="1" default="0.0"/>
  </variableTypes>

  <portTypes name="water-ports">
    <portType name="Hydraulic" connectorFamily="hydraulic">
      <variables>
        <portVariable name="H" portRole="potential" type="real"/>
        <portVariable name="Q" portRole="flow" type="real"/>
      </variables>
    </portType>
    <portType name="SpeedInput" connectorFamily="signal">
      <variables><portVariable name="v" causality="input" type="real" default="1.0"/></variables>
    </portType>
    <portType name="SpeedOutput" connectorFamily="signal">
      <variables><portVariable name="v" causality="output" type="real"/></variables>
    </portType>
  </portTypes>

  <modelTypes name="water-network">
    <!-- 定水头源/汇。 -->
    <modelType name="Reservoir">
      <ports><port name="p" portType="Hydraulic"/></ports>
      <parameters><parameter name="total_head" type="real" default="100.0"/></parameters>
      <equations><equation>p.H = total_head</equation></equations>
    </modelType>

    <!-- 需求驱动结点：p.Q 为正表示从管网取水。 -->
    <modelType name="Junction">
      <ports><port name="p" portType="Hydraulic"/></ports>
      <parameters><parameter name="base_demand" type="real" default="0.0"/></parameters>
      <equations><equation>p.Q = base_demand</equation></equations>
    </modelType>

    <!-- Hazen-Williams 管段；|Q|^0.852·sign(Q) 用 Q·(Q²+ε²)^0.426
         正则化，保证 Q=0 时 Jacobian 流量列非零。 -->
    <modelType name="Pipe">
      <ports><port name="a" portType="Hydraulic"/><port name="b" portType="Hydraulic"/></ports>
      <parameters>
        <parameter name="length" type="real" default="100.0"/>
        <parameter name="diameter" type="real" default="0.3"/>
        <parameter name="C_hw" type="real" default="100.0"/>
      </parameters>
      <equations>
        <equation>a.H - b.H = 10.67 * length * a.Q * (a.Q * a.Q + 1e-18)^0.426 / (C_hw^1.852 * diameter^4.87)</equation>
        <equation>a.Q + b.Q = 0.0</equation>
      </equations>
    </modelType>

    <!-- 泵 + 转速信号：仿射律 H = u²·H0 − k·Q|Q|。
         u=1 时与裸泵同解；u=0 是旁通，不是关断（关断用 ClosedLink）。 -->
    <modelType name="PumpSpeed">
      <ports>
        <port name="a" portType="Hydraulic"/>
        <port name="b" portType="Hydraulic"/>
        <port name="SpeedIn" portType="SpeedInput"/>
      </ports>
      <parameters>
        <parameter name="H0" type="real" default="50.0"/>
        <parameter name="k" type="real" default="0.05"/>
      </parameters>
      <equations>
        <equation>a.H + (SpeedIn.v^2 * H0 - k * a.Q * (a.Q * a.Q + 1e-18)^0.5) - b.H = 0.0</equation>
        <equation>a.Q + b.Q = 0.0</equation>
      </equations>
    </modelType>

    <!-- 转速指令源：Out.v = speed。 -->
    <modelType name="SpeedCommand">
      <ports><port name="Out" portType="SpeedOutput"/></ports>
      <parameters><parameter name="speed" type="real" default="1.0"/></parameters>
      <equations><equation>Out.v = speed</equation></equations>
    </modelType>

    <!-- 正流 PRV（PRV + 止回）。普通 PRV 在泵出口会允许倒流：
         H_set 低于下游压力时泵 Q 可为负。本组件用一条互补式方程：
           a.Q < 0     -> Q = 0        （止回关闭）
           b.H > a.H   -> Q = 0        （反向压差关闭）
           a.H > H_set -> b.H = H_set  （调节）
           否则        -> b.H = a.H    （全开）
         适合泵出口/罐出口等必须禁止倒流的位置。 -->
    <modelType name="PRVCheck">
      <ports><port name="a" portType="Hydraulic"/><port name="b" portType="Hydraulic"/></ports>
      <parameters><parameter name="H_set" type="real" default="0.0"/></parameters>
      <equations>
        <equation>ifelse(a.Q &lt; 0.0, a.Q, ifelse(b.H &gt; a.H, a.Q, ifelse(a.H &gt; H_set, b.H - H_set, b.H - a.H))) = 0.0</equation>
        <equation>a.Q + b.Q = 0.0</equation>
      </equations>
    </modelType>

    <!-- 漏损结点：固定基荷 + 压力驱动漏损。
         ifelse 而不是 max：max 在引擎里会降成无单位的 __mncp_arg_*，
         单位覆盖会掉；ifelse 版本保持 100%。 -->
    <modelType name="LeakJunction">
      <ports><port name="p" portType="Hydraulic"/></ports>
      <parameters>
        <parameter name="base_demand" type="real" default="0.0"/>
        <parameter name="elevation" type="real" default="0.0"/>
        <parameter name="leak_coeff" type="real" default="0.0"/>
        <parameter name="leak_exp" type="real" default="0.5"/>
      </parameters>
      <equations>
        <equation>p.Q = base_demand + leak_coeff * ifelse(p.H &gt; elevation, (p.H - elevation)^leak_exp, 0.0)</equation>
      </equations>
    </modelType>

    <!-- PDA + 漏损结点：售水基荷按压力折算，漏损仍走平方根律。
         P <= Pmin 时为 0，P >= Preq 时为 1，中间按 n_exp 幂律。 -->
    <modelType name="PDALeakJunction">
      <ports><port name="p" portType="Hydraulic"/></ports>
      <parameters>
        <parameter name="base_demand" type="real" default="0.0"/>
        <parameter name="elevation" type="real" default="0.0"/>
        <parameter name="Pmin" type="real" default="5.0"/>
        <parameter name="Preq" type="real" default="30.0"/>
        <parameter name="n_exp" type="real" default="0.5"/>
        <parameter name="leak_coeff" type="real" default="0.0"/>
        <parameter name="leak_exp" type="real" default="0.5"/>
      </parameters>
      <equations>
        <equation>p.Q = base_demand * ifelse(p.H - elevation &lt;= Pmin, 0.0, ifelse(p.H - elevation &gt;= Preq, 1.0, ((p.H - elevation - Pmin) / (Preq - Pmin))^n_exp)) + leak_coeff * ifelse(p.H &gt; elevation, (p.H - elevation)^leak_exp, 0.0)</equation>
      </equations>
    </modelType>
  </modelTypes>
</esml>
